# Copy to .env and fill in values: cp .env.example .env
# .env is gitignored. Never commit real keys.

# --- Database (used now: docker-compose.yml and config.py) ---
POSTGRES_USER=probable_cause
POSTGRES_PASSWORD=change-me
POSTGRES_DB=probable_cause
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Embeddings (first used in M1, ticket #9) ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- LLM for the agent (first used in M3, ticket #17) ---
# LLM_PROVIDER is "openai" or "anthropic". ANTHROPIC_API_KEY is only needed for "anthropic".
LLM_PROVIDER=openai
LLM_MODEL=
ANTHROPIC_API_KEY=

# --- Reranker (first used in M2, ticket #13) ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
